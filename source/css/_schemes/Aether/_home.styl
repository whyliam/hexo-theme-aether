// Aether — Home (rich editorial layout)
// ==================================================
// 渲染入口：layout/index.njk + layout/_partials/home/*.njk（仅在 scheme === 'Aether' 时启用）
// 所有类名都用 aether- 前缀，避免与 NexT 公共类冲突。
// 配色 / 字体 token 来自 _schemes/Aether/index.styl 的 :root --aether-*

// Aether 范围内强制 border-box，避免 padding 把组件撑出视口
[class^='aether-'],
[class*=' aether-'],
.aether-home *,
.aether-header-row,
.aether-header-row * {
  box-sizing: border-box;
}

// Line-clamp helper (Aether cards)
line-clamp(n) {
  display: -webkit-box;
  -webkit-line-clamp: n;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

$home-maxw = 1180px;
$home-pad-x = clamp(20px, 4vw, 56px);

// 主区在首页全宽 —— main-inner 强制扩到 viewport 宽度（非内容窄列）
.main-inner.aether-home {
  background: transparent;
  margin: 0 auto;
  max-width: none;
  padding: 0;
  width: 100%;
}

.aether-section {
  margin-top: var(--aether-row-gap, clamp(48px, 6vw, 80px));
  margin-left: auto;
  margin-right: auto;
  max-width: $home-maxw;
  padding: 0 $home-pad-x;
  width: 100%;
}

// section label（"02 / FEATURED ESSAYS"）
.aether-sec-label {
  align-items: center;
  color: var(--aether-muted);
  display: inline-flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  gap: 8px;
  letter-spacing: 0.16em;
  margin-bottom: 18px;
  text-transform: uppercase;
  position: relative;

  // signature dot：在 label 前面补一颗极微小的 accent 圆点，增强识别度
  &::before {
    content: '';
    background: var(--aether-accent);
    border-radius: 999px;
    height: 5px;
    width: 5px;
    opacity: .55;
    flex-shrink: 0;
    transform: translateY(-1px);
    animation: aether-sec-dot 4.2s var(--aether-ease) infinite;
  }

  .num   { color: var(--aether-ink); font-weight: 600; }
  .sep   { color: var(--aether-rule-2); }
}

@keyframes aether-sec-dot {
  0%, 100% { opacity: .35; }
  50%      { opacity: .75; }
}

@media (prefers-reduced-motion: reduce) {
  .aether-sec-label::before { animation: none; opacity: .55; }
}

.aether-sec-head {
  align-items: end;
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  justify-content: space-between;
  margin-bottom: 36px;

  h2 {
    color: var(--aether-ink);
    font-family: var(--aether-ff-serif);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.18;
    margin: 0;

    em {
      color: var(--aether-accent);
      font-family: var(--aether-ff-serif);
      font-style: italic;
      font-weight: 400;
    }
  }

  .aether-sec-subtitle {
    color: var(--aether-muted);
    font-family: var(--aether-ff-sans);
    font-size: 14px;
    line-height: 1.6;
    margin: 8px 0 0;
    max-width: 52ch;
  }

  .aether-more {
    align-items: center;
    color: var(--aether-muted);
    display: inline-flex;
    font-family: var(--aether-ff-mono);
    font-size: 12px;
    gap: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    &:hover { color: var(--aether-accent); }

    .arr { transition: transform var(--aether-base) var(--aether-ease); }
    &:hover .arr { transform: translateX(4px); }
  }
}


// ============================ 01 HERO ============================
.aether-hero {
  margin: 0 auto;
  max-width: $home-maxw;
  padding: clamp(64px, 10vh, 120px) $home-pad-x clamp(48px, 8vh, 96px);
  width: 100%;

  +mobile() {
    padding-top: 36px;
    padding-bottom: 36px;
  }
}

.aether-hero__inner {
  align-items: start;
  display: grid;
  gap: clamp(40px, 6vw, 80px);
  grid-template-columns: 1.4fr 1fr;

  +tablet-mobile() {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

.aether-hero__eyebrow {
  align-items: center;
  color: var(--aether-muted);
  display: inline-flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  gap: 10px;
  letter-spacing: 0.18em;
  margin-bottom: 28px;
  text-transform: uppercase;

  +mobile() {
    margin-bottom: 14px;
  }
}

.aether-hero__identity {
  color: var(--aether-ink);
  font-family: var(--aether-ff-sans);
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -.01em;
  line-height: 1.55;
  margin: 0 0 20px;
  max-width: 48ch;
}

.aether-hero__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: clamp(38px, 5.5vw, 72px);
  font-weight: 500;
  letter-spacing: -0.025em;
  line-height: 1.08;
  margin: 0 0 28px;

  +mobile() {
    font-size: 30px;
    margin-bottom: 18px;
  }

  em {
    color: var(--aether-accent);
    font-family: var(--aether-ff-serif);
    font-style: italic;
    font-weight: 400;
  }
}

.aether-hero__desc {
  color: var(--aether-ink-2, #4a5568);
  opacity: 0.85;
  font-family: var(--aether-ff-sans);
  font-size: 17px;
  line-height: 1.6;
  margin: 0 0 36px;
  max-width: 56ch;
}

.aether-hero__actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 48px;
}

.aether-btn {
  align-items: center;
  background: var(--aether-paper);
  border: 1px solid var(--aether-rule-2);
  border-radius: var(--aether-r-md);
  color: var(--aether-ink);
  display: inline-flex;
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 500;
  gap: 8px;
  letter-spacing: 0;
  padding: 11px 18px;
  // hover 过渡从 all 180ms 拆开为分路调节，避免“黑→蓝”硬切
  transition: background var(--aether-base) var(--aether-ease), border-color var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease), box-shadow var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    color: var(--aether-ink);
  }

  .arr { transition: transform var(--aether-base) var(--aether-ease); }
  &:hover .arr { transform: translateX(4px); }

  &.is-primary {
    background: var(--aether-ink);
    border-color: var(--aether-ink);
    color: var(--aether-paper);

    &:hover {
      background: var(--aether-accent);
      border-color: var(--aether-accent);
      color: var(--aether-paper);
      box-shadow: 0 4px 14px -6px rgba(42, 58, 107, 0.28);
    }
  }

  &.is-ghost {
    background: transparent;
    border-color: transparent;
    color: var(--aether-muted);
    padding-left: 0;
    padding-right: 0;

    &:hover { color: var(--aether-ink); }
  }
}

.aether-hero__meta {
  border-top: 1px solid var(--aether-rule);
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  gap: 24px;
  letter-spacing: 0.04em;
  padding-top: 24px;

  b {
    color: var(--aether-ink);
    font-family: var(--aether-ff-sans);
    font-size: 18px;
    font-weight: 600;
    margin-right: 4px;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: var(--aether-ink);
    }
  }
}

.aether-hero__panel {
  background: var(--aether-surface-2);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-lg);
  padding: 24px;
}

.aether-panel-label {
  align-items: center;
  color: var(--aether-muted);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 10px;
  justify-content: space-between;
  letter-spacing: 0.16em;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px dashed var(--aether-rule);
  text-transform: uppercase;

}


.aether-panel-list {
  list-style: none;
  margin: 0;
  padding: 0;

  li {
    border-bottom: 1px dashed var(--aether-rule);

    &:last-child { border-bottom: 0; }
  }

  a {
    align-items: start;
    display: grid;
    grid-template-columns: 28px 1fr 16px;
    gap: 10px;
    padding: 14px 0;
    transition: color var(--aether-base) var(--aether-ease);

    &:hover .pn   { color: var(--aether-accent); }
    &:hover .arr  { transform: translate(2px, -2px); color: var(--aether-accent); }
  }

  .pn {
    color: var(--aether-muted-2);
    font-family: var(--aether-ff-mono);
    font-size: 11px;
    padding-top: 2px;
  }

  .label {
    color: var(--aether-ink);
    font-family: var(--aether-ff-sans);
    font-size: 14px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    small {
      color: var(--aether-muted);
      display: block;
      font-family: var(--aether-ff-sans);
      font-size: 12.5px;
      font-weight: 400;
      margin-top: 4px;
      line-height: 1.45;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .arr {
    color: var(--aether-muted-2);
    font-family: var(--aether-ff-mono);
    font-size: 13px;
    transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);
  }
}


// ============================ 02 FEATURED ============================
.aether-feat-grid {
  display: grid;
  gap: 24px;
  grid-template-columns: 1.6fr 1fr;
  grid-template-rows: auto auto;

  +tablet-mobile() { grid-template-columns: 1fr; }
}

.aether-feat {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-lg);
  display: flex;
  flex-direction: column;
  padding: 36px;
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    transform: translateY(-2px);
  }

  &.is-primary {
    grid-row: span 2;
  }

  &.is-secondary {
    padding: 24px 28px;
  }
}

.aether-feat__meta {
  align-items: center;
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  gap: 12px;
  letter-spacing: 0.06em;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.aether-pill {
  background: var(--aether-paper-tint);
  border: 1px solid var(--aether-rule);
  border-radius: 999px;
  color: var(--aether-ink);
  font-family: var(--aether-ff-mono);
  font-size: 10px;
  letter-spacing: 0.10em;
  padding: 3px 10px;
}

.aether-feat__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: clamp(20px, 2vw, 28px);
  font-weight: 500;
  letter-spacing: -0.018em;
  line-height: 1.22;
  margin: 0 0 14px;
  line-clamp(3);

  .aether-feat.is-primary & {
    font-size: clamp(26px, 2.4vw, 34px);
  }

  a { color: inherit; }
}

.aether-feat__desc {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-sans);
  font-size: 14.5px;
  line-height: 1.6;
  margin: 0;
  line-clamp(3);

  .aether-feat.is-primary & {
    font-size: 16px;
  }
}

.aether-feat__footer {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: space-between;
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px dashed var(--aether-rule);
}

.aether-feat__tags {
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  gap: 12px;
  letter-spacing: 0.04em;

  span::before { content: '#'; color: var(--aether-muted-2); margin-right: 1px; }
}

.aether-feat__cta {
  color: var(--aether-accent);
  font-family: var(--aether-ff-mono);
  font-size: 11.5px;
  letter-spacing: 0.06em;
  text-transform: uppercase;

  &:hover { color: var(--aether-accent-hover); }
}


// ============================ 03 KNOWLEDGE INDEX ============================
.aether-kindex {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(4, 1fr);

  +desktop-large() { grid-template-columns: repeat(4, 1fr); }
  +desktop()       { grid-template-columns: repeat(4, 1fr); }
  +tablet()        { grid-template-columns: repeat(2, 1fr); }
  +mobile()        { grid-template-columns: 1fr; }
}

.aether-kcell {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  display: flex;
  flex-direction: column;
  padding: 24px;
  transition: all var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    transform: translateY(-2px);

    .aether-karr { transform: translate(4px, -4px); color: var(--aether-accent); }
  }

  h3 {
    color: var(--aether-ink);
    font-family: var(--aether-ff-serif);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 8px;
    line-clamp(2);
  }
}

.aether-kcode {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.10em;
  margin-bottom: 12px;
}

.aether-kdesc {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 13px;
  line-height: 1.55;
  margin: 0 0 24px;
  flex: 1;
  line-clamp(3);
}

.aether-kfoot {
  align-items: center;
  border-top: 1px dashed var(--aether-rule);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  justify-content: space-between;
  letter-spacing: 0.04em;
  padding-top: 14px;
}

.aether-kcount  { color: var(--aether-muted); }
.aether-karr    { color: var(--aether-muted-2); transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease); }


// ============================ 03 READING PATHS ============================
.aether-paths-wrap {
  max-width: none;
  padding-left: $home-pad-x;
  padding-right: $home-pad-x;
  position: relative;

  .aether-sec-label,
  .aether-sec-head {
    max-width: $home-maxw;
    margin-left: auto;
    margin-right: auto;
  }
}

.aether-paths {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 $home-pad-x;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8px;
  margin-left: unquote('calc(-1 * clamp(20px, 4vw, 56px))');
  margin-right: unquote('calc(-1 * clamp(20px, 4vw, 56px))');
  padding-left: $home-pad-x;
  padding-right: $home-pad-x;

  scrollbar-width: none;
  &::-webkit-scrollbar { display: none; }

  // last card breathing room
  &::after {
    content: '';
    flex: 0 0 1px;
  }
}

.aether-path {
  flex: 0 0 clamp(300px, 34vw, 380px);
  min-height: 260px;
  scroll-snap-align: start;
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  display: flex;
  flex-direction: column;
  padding: 28px 28px 18px;
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    transform: translateY(-2px);
  }
}

.aether-path__head {
  border-bottom: 1px dashed var(--aether-rule);
  margin-bottom: 8px;
  padding-bottom: 16px;
}

.aether-path__num {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.10em;
  margin-bottom: 10px;
  display: inline-block;
}

.aether-path__intent {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 0 0 8px;
  line-clamp(2);

  em {
    color: var(--aether-accent);
    font-family: var(--aether-ff-serif);
    font-style: italic;
    font-weight: 400;
  }
}

.aether-path__desc {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 13px;
  line-height: 1.55;
  margin: 0;
  line-clamp(2);
}

.aether-path__list {
  counter-reset: aether-step;
  list-style: none;
  margin: 0;
  padding: 0;

  li {
    border-bottom: 1px dashed var(--aether-rule);

    &:last-child { border-bottom: 0; }
  }

  a {
    align-items: center;
    color: var(--aether-ink);
    display: grid;
    gap: 12px;
    grid-template-columns: 28px 1fr 16px;
    padding: 12px 0;
    transition: color var(--aether-base) var(--aether-ease);

    &:hover {
      color: var(--aether-accent);

      .aether-path__arr { color: var(--aether-accent); transform: translateX(4px); }
      .aether-path__title { color: var(--aether-accent); }
    }
  }
}

.aether-path__step {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
}

.aether-path__body {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.aether-path__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.4;
  transition: color var(--aether-base) var(--aether-ease);
}

.aether-path__cat {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.aether-path__arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 13px;
  transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);
}

.aether-path__cta {
  align-items: center;
  background: var(--aether-paper-tint);
  border: 1px dashed var(--aether-rule-2);
  border-radius: var(--aether-r-md);
  color: var(--aether-ink);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  justify-content: space-between;
  letter-spacing: 0.04em;
  margin-top: 14px;
  padding: 16px 18px;
  transition: all var(--aether-base) var(--aether-ease);
  text-transform: uppercase;

  &:hover {
    background: var(--aether-ink);
    border-color: var(--aether-ink);
    color: var(--aether-paper);
  }
}


// ============================ 04 LATEST ============================
.aether-archive {
  border-top: 1px solid var(--aether-rule);
  display: flex;
  flex-direction: column;
}

.aether-row {
  align-items: start;
  border-bottom: 1px solid var(--aether-rule);
  display: grid;
  gap: 24px;
  grid-template-columns: 110px 160px 1fr 24px;
  padding: 24px 8px;
  transition: background var(--aether-fast) var(--aether-ease);

  +mobile() {
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 18px 4px;
  }

  &:hover { background: var(--aether-paper-tint); }
  &:hover .aether-row__title { color: var(--aether-accent); transform: translateX(2px); }
  &:hover .aether-row__arr   { color: var(--aether-accent); transform: translateX(4px); opacity: 1; }
}

.aether-row__date {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  letter-spacing: 0.04em;
}

.aether-row__cat {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
}

.aether-row__body { min-width: 0; }

.aether-row__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: clamp(18px, 2vw, 24px);
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 0 0 6px;
  transition: all var(--aether-base) var(--aether-ease);
  line-clamp(2);
}

.aether-row__desc {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  line-height: 1.55;
  margin: 0 0 8px;
  line-clamp(2);
}

.aether-row__tags {
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  gap: 12px;
  letter-spacing: 0.04em;

  span::before { content: '#'; color: var(--aether-muted-2); margin-right: 1px; }
}

.aether-row__arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 16px;
  opacity: 0;
  transition: all var(--aether-base) var(--aether-ease);

  +mobile() { display: none; }
}


// ============================ 03 BUILDING ============================
.aether-building-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(2, 1fr);

  +tablet-mobile() { grid-template-columns: 1fr; }
}

.aether-building-card {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  box-shadow: 0 1px 3px unquote('color-mix(in oklch, var(--aether-ink) 4%, transparent)');
  color: inherit;
  display: flex;
  flex-direction: column;
  padding: 28px;
  text-decoration: none;
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease), box-shadow var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    box-shadow: 0 8px 24px unquote('color-mix(in oklch, var(--aether-ink) 8%, transparent)');
    transform: translateY(-3px);
  }
}

.aether-bc-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}

.aether-bc-num {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
}

.aether-bc-status {
  border: 1px solid var(--aether-rule);
  border-radius: 999px;
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10px;
  letter-spacing: 0.10em;
  padding: 2px 8px;
  text-transform: uppercase;

  &.is-live { border-color: var(--aether-accent); color: var(--aether-accent); }
  &.is-rd   { border-color: var(--aether-rule-2); color: var(--aether-muted); }
  &.is-done { border-color: var(--aether-rule-2); color: var(--aether-muted); }
}

.aether-bc-title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 0;
  line-clamp(2);
}

.aether-bc-desc {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 13.5px;
  line-height: 1.55;
  margin: 8px 0 0;
  line-clamp(3);
}

.aether-bc-foot {
  margin-top: auto;
  padding-top: 20px;
  text-align: right;
}

.aether-bc-arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 14px;
  transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);

  .aether-building-card:hover & {
    color: var(--aether-accent);
    transform: translateX(4px);
  }
}


// ============================ 05 SERIES & PROJECTS ============================
.aether-split {
  display: grid;
  gap: 24px;
  grid-template-columns: 1fr 1fr;

  +tablet-mobile() { grid-template-columns: 1fr; }

  &:has(> :only-child) { grid-template-columns: 1fr; }
}

.aether-series-card {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  padding: 28px 28px 12px;
}

.aether-sc-head {
  align-items: center;
  border-bottom: 1px solid var(--aether-rule);
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 14px;

  h3 {
    color: var(--aether-ink);
    font-family: var(--aether-ff-serif);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .meta {
    color: var(--aether-muted);
    font-family: var(--aether-ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }
}

.aether-series-list {
  list-style: none;
  margin: 0;
  padding: 0;

  li {
    border-bottom: 1px dashed var(--aether-rule);
    padding: 14px 0;

    &:last-child { border-bottom: 0; }

    > a, &:not(:has(a)) {
      align-items: center;
      display: grid;
      gap: 12px;
      grid-template-columns: 36px 1fr auto;
    }

    > a {
      text-decoration: none;
      color: inherit;
      transition: opacity 0.15s ease;
      &:hover { opacity: 0.7; }
    }

    .pn {
      color: var(--aether-muted-2);
      font-family: var(--aether-ff-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
    }

    .label {
      color: var(--aether-ink);
      font-family: var(--aether-ff-sans);
      font-size: 14px;
      font-weight: 500;

      small {
        color: var(--aether-muted);
        display: block;
        font-family: var(--aether-ff-sans);
        font-size: 12.5px;
        font-weight: 400;
        margin-top: 3px;
      }
    }

    .status {
      border: 1px solid var(--aether-rule);
      border-radius: 999px;
      color: var(--aether-muted);
      font-family: var(--aether-ff-mono);
      font-size: 10px;
      letter-spacing: 0.10em;
      padding: 2px 8px;
      text-transform: uppercase;
    }

    .status.is-live { border-color: var(--aether-accent); color: var(--aether-accent); }
    .status.is-done { border-color: var(--aether-rule-2); color: var(--aether-muted); }
    .status.is-rd   { border-color: var(--aether-rule-2); color: var(--aether-muted); }
  }
}


// ---- Series Bento Grid (full-width fallback, no projects) ----
.aether-series-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(2, 1fr);

  +tablet-mobile() { grid-template-columns: 1fr; }
}

.aether-series-tile {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  box-shadow: 0 1px 3px unquote('color-mix(in oklch, var(--aether-ink) 4%, transparent)');
  color: inherit;
  display: flex;
  flex-direction: column;
  min-height: 200px;
  padding: 28px;
  text-decoration: none;
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease), box-shadow var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    box-shadow: 0 8px 24px unquote('color-mix(in oklch, var(--aether-ink) 8%, transparent)');
    transform: translateY(-3px);
  }

  &.is-featured {
    grid-column: span 2;

    +tablet-mobile() { grid-column: span 1; }
  }

  &.no-posts .aether-st-foot { margin-top: auto; }
}

.aether-st-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}

.aether-st-num {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
}

.aether-st-status {
  border: 1px solid var(--aether-rule);
  border-radius: 999px;
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10px;
  letter-spacing: 0.10em;
  padding: 2px 8px;
  text-transform: uppercase;

  &.is-live { border-color: var(--aether-accent); color: var(--aether-accent); }
  &.is-done { border-color: var(--aether-rule-2); color: var(--aether-muted); }
}

.aether-st-title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 0;
  line-clamp(2);

  .is-featured & { font-size: 26px; }
}

.aether-st-desc {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 13.5px;
  line-height: 1.55;
  margin: 8px 0 0;
  line-clamp(2);
}

.aether-st-posts {
  border-top: 1px dashed var(--aether-rule);
  margin-top: auto;
  padding-top: 16px;
}

.aether-st-post {
  display: flex;
  gap: 12px;
  padding: 4px 0;

  & + & { margin-top: 4px; }
}

.aether-st-post-label {
  color: var(--aether-muted);
  flex-shrink: 0;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.08em;
  padding-top: 2px;
  text-transform: uppercase;
}

.aether-st-post-title {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  .is-featured & {
    white-space: normal;
    line-clamp(2);
  }
}

.aether-st-foot {
  align-items: center;
  border-top: 1px dashed var(--aether-rule);
  display: flex;
  gap: 16px;
  margin-top: 20px;
  padding-top: 14px;
}

.aether-st-count,
.aether-st-date {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
}

.aether-st-date { color: var(--aether-muted-2); }

.aether-st-arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 14px;
  margin-left: auto;
  transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);

  .aether-series-tile:hover & {
    color: var(--aether-accent);
    transform: translateX(4px);
  }
}


// ============================ 06 NOTES ============================
.aether-notes {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(4, 1fr);

  +tablet() { grid-template-columns: repeat(2, 1fr); }
  +mobile() { grid-template-columns: 1fr; }
}

.aether-note {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  padding: 22px 22px 18px;
  transition: all var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    transform: translateY(-2px);
  }

  h3 {
    color: var(--aether-ink);
    font-family: var(--aether-ff-serif);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 10px;
    line-clamp(2);
  }

  p {
    color: var(--aether-ink-2);
    font-family: var(--aether-ff-sans);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0 0 14px;
    line-clamp(3);
  }
}

.aether-ndate {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  margin-bottom: 12px;
}

.aether-ntags {
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  gap: 10px;
  letter-spacing: 0.04em;

  span::before { content: '#'; color: var(--aether-muted-2); margin-right: 1px; }
}


// ============================ 07 VISUALS ============================
.aether-visuals {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(5, 1fr);

  +desktop()       { grid-template-columns: repeat(5, 1fr); }
  +tablet()        { grid-template-columns: repeat(3, 1fr); }
  +mobile()        { grid-template-columns: repeat(2, 1fr); }
}

.aether-visual {
  background: var(--aether-surface-2);
  border-radius: var(--aether-r-md);
  display: block;
  overflow: hidden;
  position: relative;
  aspect-ratio: unquote('4 / 5');
  transition: transform var(--aether-base) var(--aether-ease);

  &:hover { transform: translateY(-3px); }
}

.aether-v-img {
  background: linear-gradient(135deg, var(--aether-rule-2), var(--aether-paper-tint));
  height: 100%;
  width: 100%;
}

.aether-visual.no-bg .aether-v-placeholder {
  align-items: center;
  background: var(--aether-bg-alt, oklch(96% .004 250));
  border: 1px dashed var(--aether-rule);
  border-radius: var(--aether-r-sm, 6px);
  display: flex;
  height: 100%;
  justify-content: center;

  span {
    color: var(--aether-muted);
    font-family: var(--aether-ff-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
}

.aether-visual.has-bg .aether-v-img {
  background-position: center;
  background-size: cover;
}

.aether-v-meta {
  bottom: 10px;
  color: white;
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  justify-content: space-between;
  left: 12px;
  letter-spacing: 0.06em;
  position: absolute;
  right: 12px;
  text-shadow: 0 1px 6px rgba(0,0,0,.35);
  z-index: 1;
}


// ============================ 05 NOTES & VISUALS MERGED ============================
.aether-nv-split {
  display: grid;
  gap: 32px;
  grid-template-columns: 1fr 1fr;

  &.is-single {
    grid-template-columns: 1fr;
  }

  +tablet-mobile() { grid-template-columns: 1fr; }
}

.aether-nv-label {
  align-items: center;
  border-bottom: 1px solid var(--aether-rule);
  color: var(--aether-muted);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  justify-content: space-between;
  letter-spacing: 0.10em;
  margin-bottom: 16px;
  padding-bottom: 12px;
  text-transform: uppercase;

  a {
    color: var(--aether-muted);
    font-size: 10.5px;
    &:hover { color: var(--aether-accent); }
    .arr { transition: transform var(--aether-base) var(--aether-ease); }
    &:hover .arr { transform: translateX(3px); }
  }
}

.aether-nv-notes {
  .aether-note {
    margin-bottom: 12px;

    &:last-child { margin-bottom: 0; }
  }
}

.aether-nv-grid {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(2, 1fr);
}

.aether-nv-visuals .aether-visual {
  aspect-ratio: unquote('1 / 1');

  &.no-bg .aether-v-placeholder {
    align-items: center;
    background: var(--aether-bg-alt, oklch(96% 0.004 250));
    border: 1px dashed var(--aether-rule);
    border-radius: var(--aether-r-sm, 6px);
    display: flex;
    height: 100%;
    justify-content: center;

    span {
      color: var(--aether-muted);
      font-family: var(--aether-ff-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }
}


// ============================ 06 SUBSCRIBE ============================
.aether-subscribe {
  margin-top: var(--aether-row-gap, clamp(48px, 6vw, 80px));
}

.aether-subscribe-bar {
  align-items: center;
  border-top: 1px solid var(--aether-rule);
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: space-between;
  padding-top: 24px;
}

.aether-subscribe-text {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.aether-subscribe-links {
  align-items: center;
  color: var(--aether-muted);
  display: flex;
  flex-wrap: wrap;
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  gap: 14px;

  a {
    color: var(--aether-muted);
    transition: color var(--aether-base) var(--aether-ease);
    &:hover { color: var(--aether-ink); }
  }
}

.aether-subscribe-dot {
  color: var(--aether-rule-2);
  font-size: 10px;
}


// ============================ POST FOOTER CTA ============================
// "Follow the archive" strip — injected via theme_inject into postBodyEnd.
// Lives inside the post body container, so it inherits the article width.
.aether-post-cta {
  background: var(--aether-surface);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-lg);
  display: grid;
  gap: 28px;
  grid-template-columns: 1.2fr 1fr;
  margin: 56px 0 24px;
  padding: 32px clamp(24px, 4vw, 40px);

  +tablet-mobile() {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

.aether-post-cta__head {
  > * + * { margin-top: 10px; }

  h2 {
    color: var(--aether-ink);
    font-family: var(--aether-ff-serif);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.018em;
    margin: 0;
  }

  p {
    color: var(--aether-muted);
    font-family: var(--aether-ff-sans);
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0;
    max-width: 50ch;
  }
}

.aether-post-cta__eyebrow {
  color: var(--aether-muted);
  display: inline-block;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.aether-post-cta__channels,
.aether-post-cta__empty {
  align-content: start;
  display: grid;
  gap: 6px;
}

.aether-post-cta__channel {
  align-items: center;
  background: var(--aether-paper);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  color: var(--aether-ink);
  display: grid;
  font-family: var(--aether-ff-sans);
  gap: 10px;
  grid-template-columns: auto 1fr 14px;
  padding: 11px 16px;
  transition: all var(--aether-base) var(--aether-ease);

  &:hover {
    background: var(--aether-ink);
    border-color: var(--aether-ink);
    color: var(--aether-paper);

    .aether-post-cta__hint { color: unquote('color-mix(in srgb, var(--aether-paper) 70%, transparent)'); }
    .aether-post-cta__arr  { color: var(--aether-paper); transform: translateX(4px); }
  }
}

.aether-post-cta__label {
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 500;
}

.aether-post-cta__hint {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  text-align: right;
}

.aether-post-cta__arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 13px;
  transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);
}


// ============================ FOOTER ============================
.aether-footer {
  border-top: 1px solid var(--aether-rule);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  max-width: 1180px;
  margin: 0 auto;
  padding: 36px 0 24px;
}

.aether-foot-brand {
  .aether-foot-logo {
    font-family: var(--aether-ff-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--aether-ink);
  }

  p {
    margin: 4px 0 0;
    font-family: var(--aether-ff-mono);
    font-size: 11px;
    color: var(--aether-muted);
    letter-spacing: 0.04em;
  }
}

.aether-foot-nav {
  display: flex;
  gap: 20px;

  a {
    font-family: var(--aether-ff-sans);
    font-size: 13px;
    color: var(--aether-fg-2);
    text-decoration: none;
    transition: color 0.15s ease;

    &:hover { color: var(--aether-accent); }
  }
}

.aether-foot-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  color: var(--aether-muted-2);
  letter-spacing: 0.03em;

  a {
    color: var(--aether-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    &:hover { color: var(--aether-accent); }
  }
}

.aether-foot-social {
  display: inline-flex;
  gap: 4px;

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--aether-muted);
    text-decoration: none;
    transition: color 0.15s;

    &:hover { color: var(--aether-accent); }
  }
}

+mobile() {
  .aether-footer {
    flex-direction: column;
    align-items: flex-start;
  }
  .aether-foot-meta {
    align-items: flex-start;
  }
}


// ============================ AWARD-LEVEL UPGRADES ============================

// ── Scroll reveal ──
.aether-reveal--hidden {
  opacity: 0;
  transform: translateY(32px);
}

.aether-reveal--visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1);
}

// ── Hero entrance choreography ──
.aether-hero-step--hidden {
  opacity: 0;
  transform: translateY(24px);
}

.aether-hero-step--visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.65s cubic-bezier(.16,1,.3,1), transform 0.65s cubic-bezier(.16,1,.3,1);
}

// Panel slides from right
.aether-hero__panel.aether-hero-step--hidden {
  opacity: 0;
  transform: translateX(40px);
}

.aether-hero__panel.aether-hero-step--visible {
  opacity: 1;
  transform: translateX(0);
}

// ── Background rhythm — alternate sections ──
// Every even section gets a subtle surface bg band.
// Instead of breaking max-width, use a pseudo-element for full-bleed bg.
.aether-section:nth-child(even) {
  position: relative;
  padding-top: clamp(56px, 7vw, 96px);
  padding-bottom: clamp(56px, 7vw, 96px);

  &::before {
    content: '';
    position: absolute;
    inset: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    background: var(--aether-surface);
    border-top: 1px solid var(--aether-rule);
    border-bottom: 1px solid var(--aether-rule);
    z-index: -1;
    pointer-events: none;
  }
}

// Subscribe bar doesn't need alternating bg
.aether-subscribe {
  &:nth-child(even)::before { display: none; }
}

// ── Typography tightening ──
.aether-hero__title {
  letter-spacing: -0.035em;
}

.aether-sec-head h2 {
  letter-spacing: -0.025em;
}

.aether-sec-label {
  .num {
    font-size: 16px;
    font-weight: 700;
    color: var(--aether-accent);
  }
}

.aether-hero__meta b {
  font-variant-numeric: tabular-nums;
}

// ── Card refinement ──
.aether-feat,
.aether-path,
.aether-note,
.aether-series-card {
  box-shadow: 0 1px 3px unquote('color-mix(in oklch, var(--aether-ink) 4%, transparent)');
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease), box-shadow var(--aether-base) var(--aether-ease);

  &:hover {
    box-shadow: 0 8px 24px unquote('color-mix(in oklch, var(--aether-ink) 8%, transparent)');
    transform: translateY(-3px);
  }
}

// Featured primary: left accent border
.aether-feat.is-primary {
  border-left: 3px solid var(--aether-accent);
}

// ── Header compact on scroll ──
.header.is-compact {
  .aether-header-row {
    padding-top: 8px;
    padding-bottom: 8px;
  }
}

.header {
  transition: background 0.2s ease, border-color 0.2s ease;
}

.header.is-scrolled {
  border-bottom-color: var(--aether-rule-2);
  box-shadow: 0 1px 8px unquote('color-mix(in oklch, var(--aether-ink) 5%, transparent)');
}

// ── Dark mode toggle button ──
.aether-dark-toggle {
  align-items: center;
  background: transparent;
  border: 1px solid var(--aether-rule);
  border-radius: 999px;
  color: var(--aether-muted);
  cursor: pointer;
  display: flex;
  font-size: 16px;
  height: 32px;
  justify-content: center;
  margin-left: 8px;
  transition: all var(--aether-fast) var(--aether-ease);
  width: 32px;

  &:hover {
    border-color: var(--aether-accent);
    color: var(--aether-accent);
  }
}

// ── Smooth page scroll ──
html {
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .aether-reveal--hidden,
  .aether-reveal--visible,
  .aether-hero-step--hidden,
  .aether-hero-step--visible {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

@media print {
  .aether-reveal--hidden {
    opacity: 1 !important;
    transform: none !important;
  }
}

// ── Visuals hover: scale instead of translate ──
.aether-visual {
  &:hover {
    transform: scale(1.03);
  }

  .aether-v-img {
    transition: transform 0.4s cubic-bezier(.16,1,.3,1);
  }

  &:hover .aether-v-img {
    transform: scale(1.06);
  }
}

// ── Latest rows: better hover ──
.aether-row {
  border-radius: var(--aether-r-md);
  transition: background var(--aether-fast) var(--aether-ease), box-shadow var(--aether-fast) var(--aether-ease);

  &:hover {
    background: var(--aether-surface);
    box-shadow: 0 2px 12px unquote('color-mix(in oklch, var(--aether-ink) 5%, transparent)');
  }
}
