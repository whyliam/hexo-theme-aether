// Aether — Series detail + Series-index + Series-nav
// ==================================================

// ---------- Series detail / index page ----------
.aether-series-detail {
  margin: 0 auto;
  max-width: 820px;
  padding: clamp(48px, 9vh, 96px) clamp(20px, 5vw, 56px) clamp(72px, 10vh, 120px);
}

.aether-series-detail__hero {
  margin-bottom: clamp(48px, 7vh, 80px);
}

.aether-series-detail__eyebrow {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  margin-bottom: 24px;
  text-transform: uppercase;
}

.aether-series-detail__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: clamp(32px, 4.5vw, 56px);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0 0 24px;
  overflow-wrap: break-word;
  word-break: break-word;
}

.aether-series-detail__lede {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-serif);
  font-size: clamp(17px, 1.6vw, 20px);
  font-style: italic;
  line-height: 1.55;
  margin: 0 0 32px;
  max-width: 56ch;
}

.aether-series-detail__meta {
  border-bottom: 1px solid var(--aether-rule);
  border-top: 1px solid var(--aether-rule);
  display: flex;
  gap: 32px;
  margin: 0;
  padding: 18px 0;

  > div { display: flex; flex-direction: column; gap: 4px; }

  dt {
    color: var(--aether-muted);
    font-family: var(--aether-ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  dd {
    color: var(--aether-ink);
    font-family: var(--aether-ff-sans);
    font-size: 14px;
    margin: 0;
  }
}

.aether-series-detail__list { margin-top: 48px; }

// ---------- Series index grid ----------
.aether-si-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(2, 1fr);

  +mobile() { grid-template-columns: 1fr; }
}

.aether-si-card {
  background: var(--aether-paper);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-md);
  color: var(--aether-ink);
  display: flex;
  flex-direction: column;
  padding: 28px 28px 24px;
  transition: border-color var(--aether-base) var(--aether-ease), transform var(--aether-base) var(--aether-ease);

  &:hover {
    border-color: var(--aether-ink);
    transform: translateY(-3px);

    .aether-si-card__title { color: var(--aether-accent); }
    .aether-si-card__cta   { color: var(--aether-accent); }
  }

  &.is-featured {
    grid-column: span 2;

    +mobile() { grid-column: span 1; }
  }
}

.aether-si-card__head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 14px;
}

.aether-si-card__num {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.aether-si-card__stat {
  background: var(--aether-paper-tint);
  border-radius: 999px;
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  padding: 3px 10px;
}

.aether-si-card__title {
  font-family: var(--aether-ff-serif);
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 0 0 10px;
  transition: color var(--aether-base) var(--aether-ease);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;

  .is-featured & { font-size: 26px; }
}

.aether-si-card__meta {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  margin-bottom: 16px;
}

.aether-si-card__recent {
  border-top: 1px dashed var(--aether-rule);
  flex: 1;
  list-style: none;
  margin: 0;
  padding: 14px 0 0;

  li {
    align-items: baseline;
    color: var(--aether-ink-2);
    display: flex;
    font-family: var(--aether-ff-sans);
    font-size: 13.5px;
    gap: 10px;
    line-height: 1.4;
    padding: 5px 0;
  }
}

.aether-si-card__dot {
  background: var(--aether-rule-2);
  border-radius: 50%;
  flex-shrink: 0;
  height: 4px;
  margin-top: 7px;
  width: 4px;
}

.aether-si-card__post-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aether-si-card__cta {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  letter-spacing: 0.06em;
  margin-top: 16px;
  transition: color var(--aether-base) var(--aether-ease);
}

.aether-series-detail__sec-label {
  align-items: center;
  color: var(--aether-muted);
  display: inline-flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  gap: 8px;
  letter-spacing: 0.16em;
  margin-bottom: 24px;
  text-transform: uppercase;

  .num { color: var(--aether-ink); font-weight: 600; }
  .sep { color: var(--aether-rule-2); }
}

.aether-series-detail__posts {
  border-top: 1px solid var(--aether-rule);
  list-style: none;
  margin: 0;
  padding: 0;

  li {
    border-bottom: 1px solid var(--aether-rule);

    a {
      align-items: start;
      color: var(--aether-ink);
      display: grid;
      gap: 20px;
      grid-template-columns: 56px 1fr 20px;
      padding: 22px 4px;
      transition: background var(--aether-fast) var(--aether-ease);

      &:hover {
        background: var(--aether-paper-tint);

        .aether-series-detail__post-title { color: var(--aether-accent); }
        .aether-series-detail__arr        { color: var(--aether-accent); transform: translateX(4px); }
      }
    }
  }
}

.aether-series-detail__num {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 13px;
  letter-spacing: 0.04em;
  padding-top: 4px;
}

.aether-series-detail__body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.aether-series-detail__post-title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-serif);
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.3;
  transition: color var(--aether-base) var(--aether-ease);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.aether-series-detail__post-desc {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-sans);
  font-size: 13.5px;
  line-height: 1.55;
}

.aether-series-detail__post-meta {
  color: var(--aether-muted);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  gap: 8px;
  letter-spacing: 0.06em;
  margin-top: 2px;
  text-transform: uppercase;
}

.aether-series-detail__arr {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 14px;
  padding-top: 6px;
  transition: transform var(--aether-base) var(--aether-ease), color var(--aether-base) var(--aether-ease);
}


// ---------- Continue-this-path nav (injected at post bottom) ----------
.aether-series-nav {
  border-top: 1px solid var(--aether-rule);
  margin: 32px 0 0;
  padding: 16px 0 0;
}

.aether-series-nav__head {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 12px;
}

.aether-series-nav__title {
  border: 0;
  color: var(--aether-ink);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 600;
}

.aether-series-nav__position,
.aether-series-nav__status,
.aether-series-nav__all {
  color: var(--aether-muted);
  font-size: 12px;
  line-height: 1.5;
}

.aether-series-nav__position { font-family: var(--aether-ff-mono); }
.aether-series-nav__all { border: 0; margin-left: auto; }

.aether-series-nav__cards {
  display: grid;
  gap: 12px 24px;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  margin-top: 12px;

  +mobile() { grid-template-columns: minmax(0, 1fr); gap: 4px; }
}

.aether-series-nav__card {
  border: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  padding: 6px 0;

  &.is-next { grid-column: 2; text-align: right; }
  &:only-child { grid-column: 1 / -1; text-align: left; }
  &:hover .aether-series-nav__post-title { color: var(--aether-accent); }
  &:focus-visible { outline: 2px solid var(--aether-accent); outline-offset: 4px; }

  +mobile() { &.is-next { grid-column: 1; text-align: left; } }
}

.aether-series-nav__label {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 12px;
  line-height: 1.5;
}

.aether-series-nav__post-title {
  color: var(--aether-ink-2);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.6;
  overflow-wrap: anywhere;
  transition: color var(--aether-fast) var(--aether-ease);
}
