// Aether — ⌘K command palette UI
// ==================================================

.aether-cmdk-open { overflow: hidden; }

.aether-cmdk {
  align-items: flex-start;
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  padding-top: 12vh;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 99999;

  &[hidden] { display: none; }
}

.aether-cmdk__backdrop {
  background: rgba(8, 8, 12, .35);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  bottom: 0;
  cursor: pointer;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}

.aether-cmdk__panel {
  background: var(--aether-paper);
  border: 1px solid var(--aether-rule-2);
  border-radius: var(--aether-r-lg);
  box-shadow: 0 24px 60px rgba(20, 20, 24, .25);
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  overflow: hidden;
  position: relative;
  width: min(620px, 92vw);
}

.aether-cmdk__inputbar {
  align-items: center;
  border-bottom: 1px solid var(--aether-rule);
  display: flex;
  gap: 12px;
  padding: 14px 18px;
}

.aether-cmdk__prompt {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 12px;
  letter-spacing: 0.10em;
}

.aether-cmdk__input {
  background: transparent;
  border: 0;
  color: var(--aether-ink);
  flex: 1;
  font-family: var(--aether-ff-sans);
  font-size: 16px;
  outline: 0;
  padding: 0;

  &::placeholder { color: var(--aether-muted-2); }
}

.aether-cmdk__esc {
  background: var(--aether-paper-tint);
  border: 1px solid var(--aether-rule);
  border-radius: var(--aether-r-sm);
  color: var(--aether-muted);
  cursor: pointer;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.06em;
  padding: 3px 7px;
}

.aether-cmdk__filters {
  border-bottom: 1px solid var(--aether-rule);
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 10px 16px;

  button {
    background: transparent;
    border: 1px solid var(--aether-rule);
    border-radius: 999px;
    color: var(--aether-muted);
    cursor: pointer;
    font-family: var(--aether-ff-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    transition: all var(--aether-fast) var(--aether-ease);

    &:hover { color: var(--aether-ink); border-color: var(--aether-rule-2); }
    &.is-on {
      background: var(--aether-ink);
      border-color: var(--aether-ink);
      color: var(--aether-paper);
    }
  }
}

.aether-cmdk__status {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.06em;
  padding: 8px 18px 0;
}

.aether-cmdk__results {
  flex: 1;
  list-style: none;
  margin: 0;
  overflow-y: auto;
  padding: 8px 0;
}

.aether-cmdk__item {
  align-items: center;
  cursor: pointer;
  display: grid;
  gap: 14px;
  grid-template-columns: 56px 1fr auto;
  padding: 10px 18px;
  transition: background var(--aether-fast) var(--aether-ease);

  &.is-on { background: var(--aether-accent-tint); }
}

.aether-cmdk__kind {
  color: var(--aether-muted);
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  letter-spacing: 0.10em;
  text-transform: uppercase;

  .aether-cmdk__item.is-on & { color: var(--aether-accent); }
}

.aether-cmdk__body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.aether-cmdk__title {
  color: var(--aether-ink);
  font-family: var(--aether-ff-sans);
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  .aether-cmdk__item.is-on & { color: var(--aether-accent); }
}

.aether-cmdk__sum {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aether-cmdk__date {
  color: var(--aether-muted-2);
  font-family: var(--aether-ff-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
}

.aether-cmdk__empty {
  color: var(--aether-muted);
  font-family: var(--aether-ff-sans);
  font-size: 13.5px;
  padding: 20px 18px;
  text-align: center;
}

.aether-cmdk__hint {
  border-top: 1px solid var(--aether-rule);
  color: var(--aether-muted-2);
  display: flex;
  font-family: var(--aether-ff-mono);
  font-size: 10.5px;
  gap: 18px;
  letter-spacing: 0.06em;
  padding: 10px 18px;

  kbd {
    background: var(--aether-paper-tint);
    border: 1px solid var(--aether-rule);
    border-radius: 3px;
    margin: 0 4px;
    padding: 1px 5px;
  }
}
