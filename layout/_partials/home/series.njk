{%- set cfg = theme.aether.series -%}
{%- set auto_series = aether_series() -%}
{%- if auto_series.length %}
<section class="aether-section" id="aether-series">
  <div class="aether-sec-head">
    <h2>{{ (cfg.title or aether_text('series')) | safe }}</h2>
    <a class="aether-more" href="{{ url_for('/series/') }}">{{ aether_text('all_series') }} <span class="arr">→</span></a>
  </div>
  {%- set selection = aether_series_selection(auto_series, cfg.featured) -%}
  {%- set featured = selection.featured -%}
  {%- if featured %}
  <a class="aether-series-lead" href="{{ url_for(featured.url or '/series/') }}">
    <div class="aether-series-lead__intro">
      <p class="aether-series-lead__label">{{ aether_text('featured_series') }}{% if featured.posts and featured.posts.length %}<span>{{ date(featured.posts[0].date, 'YYYY') }} — {{ date(featured.latest_date or featured.posts[featured.posts.length - 1].date, 'YYYY') }}</span>{% endif %}</p>
      <h3>{{ featured.name }}</h3>
      {%- if cfg.featured_description or featured.subtitle %}<p class="aether-series-lead__description">{{ cfg.featured_description or featured.subtitle }}</p>{% endif %}
      <p class="aether-series-lead__count"><strong>{{ featured.count or '—' }}</strong> {{ aether_text('articles') }}<span aria-hidden="true">↗</span></p>
    </div>
    <div class="aether-series-lead__reading">
      <p class="aether-series-lead__invitation">{{ aether_text('series_invitation') }}</p>
      <span class="aether-series-entry__link">{{ aether_text('browse_series') }} ↗</span>
      {%- if featured.latest_date %}<p class="aether-series-lead__updated">{{ aether_text('updated') }} <time datetime="{{ date(featured.latest_date, 'YYYY-MM-DD') }}">{{ date(featured.latest_date, 'YYYY-MM-DD') }}</time></p>{% endif %}
    </div>
  </a>
  {%- endif %}
  {%- if selection.others.length %}
  <div class="aether-series-secondary">
    {%- for s in selection.others %}
    <a class="aether-series-entry" href="{{ url_for(s.url or '/series/') }}">
      <div class="aether-series-entry__meta"><span>{{ aether_text('article_count', s.count or '—') }}{% if s.posts and s.posts.length %} · {{ aether_text('since_short', date(s.posts[0].date, 'YYYY')) }}{% endif %}</span>{% if s.latest_date %}<time datetime="{{ date(s.latest_date, 'YYYY-MM-DD') }}">{{ aether_text('updated') }} {{ date(s.latest_date, 'YYYY-MM-DD') }}</time>{% endif %}</div>
      <h3>{{ s.name }}</h3>
      {%- if s.posts and s.posts.length %}<p class="aether-series-entry__latest">{{ aether_display_title(s.posts[s.posts.length - 1]) }}</p>{% elif s.subtitle %}<p class="aether-series-entry__latest">{{ s.subtitle }}</p>{% endif %}
      <span class="aether-series-entry__link">{{ aether_text('browse_series') }} <span aria-hidden="true">↗</span></span>
    </a>
    {%- endfor %}
  </div>
  {%- endif %}
</section>
{%- endif %}
