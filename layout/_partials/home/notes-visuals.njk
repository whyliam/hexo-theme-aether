{%- set cfg = theme.aether.notes_visuals or {} -%}
{%- set ncfg = theme.aether.notes or {} -%}
{%- set vcfg = theme.aether.visuals or {} -%}
{%- set notes = aether_notes(ncfg.limit) if ncfg.enable !== false else [] -%}
{%- set visuals = aether_visuals(vcfg.limit) if vcfg.enable !== false else [] -%}
{%- if (notes and notes.length) or (visuals and visuals.length) %}
<section class="aether-section" id="aether-personal">
  <div class="aether-sec-head">
    <h2>{{ cfg.title or aether_text('personal') | safe }}</h2>
    {%- if cfg.subtitle %}
      <p class="aether-sec-subtitle">{{ cfg.subtitle }}</p>
    {%- endif %}
  </div>

  <div class="aether-nv-split{% if not (notes and notes.length) or not (visuals and visuals.length) %} is-single{% endif %}">
    {%- if notes and notes.length %}
    <div class="aether-nv-notes">
      <div class="aether-nv-label">
        <span>{{ aether_text('notes') }}</span>
        <a href="{{ url_for(ncfg.more_url or '/archives/') }}">{{ aether_text('all') }} <span class="arr">→</span></a>
      </div>
      {%- for note in notes %}
        <a class="aether-note" href="{{ aether_post_url(note) }}">
          <div class="aether-ndate">{{ date(note.date, 'YYYY-MM-DD') }}</div>
          <h3>{{ note.title }}</h3>
          {%- set sum = aether_summary(note, 60) -%}
          {%- if sum %}<p>{{ sum }}</p>{% endif %}
        </a>
      {%- endfor %}
    </div>
    {%- endif %}

    {%- if visuals and visuals.length %}
    <div class="aether-nv-visuals">
      <div class="aether-nv-label">
        <span>{{ aether_text('visuals') }}</span>
        <a href="{{ url_for(vcfg.more_url or ('/visuals/' if theme.aether.visuals_page.enable !== false else '/archives/')) }}">{{ aether_text('all') }} <span class="arr">→</span></a>
      </div>
      <div class="aether-nv-grid">
        {%- for v in visuals %}
          {%- set cover = aether_visual_cover(v) -%}
          <a class="aether-visual {% if cover %}has-bg{% else %}no-bg{% endif %}" href="{{ aether_post_url(v) }}"
             >
            {%- if cover %}
            <img class="aether-v-img" src="{{ url_for(cover) }}" alt="{{ v.location or v.title }}" width="640" height="480" loading="lazy" decoding="async">
            {%- else %}
            <div class="aether-v-img aether-v-placeholder">
              <span>{{ (v.location or v.title) | truncate(20) }}</span>
            </div>
            {%- endif %}
            <div class="aether-v-meta">
              <span>{{ (v.location or v.title) | upper }}</span>
              <span>{{ date(v.date, 'YYYY-MM') }}</span>
            </div>
          </a>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}
