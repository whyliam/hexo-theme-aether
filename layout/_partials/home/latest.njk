{%- set cfg = theme.aether.latest -%}
{%- set posts = aether_latest(cfg.limit or 5) -%}
{%- if posts and posts.length %}
<section class="aether-section" id="aether-latest" data-aether-reveal>
  <div class="aether-sec-label">
    {%- set parts = (cfg.section_label or '04 / 最近更新').split('/') -%}
    <span class="num">{{ parts[0] | trim }}</span>
    {%- if parts.length > 1 %}<span class="sep">/</span><span>{{ parts.slice(1).join('/') | trim }}</span>{% endif %}
  </div>
  <div class="aether-sec-head">
    <h2>{{ cfg.title | safe }}</h2>
    <a class="aether-more" href="{{ url_for('/archives/') }}">所有文章 ({{ site.posts.length }}) <span class="arr">→</span></a>
  </div>

  <div class="aether-archive">
    {%- for post in posts %}
      {%- set cat = aether_post_category(post) -%}
      <a class="aether-row" href="{{ aether_post_url(post) }}">
        <span class="aether-row__date">{{ date(post.date, 'YYYY-MM-DD') }}</span>
        <span class="aether-row__cat">A-{{ aether_pad(loop.index, 3) }}{%- if cat %} · {{ cat | upper }}{% endif -%}</span>
        <div class="aether-row__body">
          <h3 class="aether-row__title">{{ post.title }}</h3>
          {%- set sum = aether_summary(post, 130) -%}
          {%- if sum %}<p class="aether-row__desc">{{ sum }}</p>{% endif %}
          {%- if post.tags and post.tags.length %}
            <div class="aether-row__tags">
              {%- for tag in post.tags.toArray().slice(0, 3) -%}
                <span>{{ tag.name }}</span>
              {%- endfor -%}
            </div>
          {%- endif %}
        </div>
        <span class="aether-row__arr">→</span>
      </a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
