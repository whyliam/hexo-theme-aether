{%- set cfg = theme.aether.latest -%}
{%- set posts = aether_latest(cfg.limit) -%}
{%- if posts and posts.length %}
<section class="aether-section" id="aether-latest">
  <div class="aether-sec-head">
    <h2>{{ (cfg.title or aether_text('latest')) | safe }}</h2>
    <a class="aether-more" href="{{ url_for('/archives/') }}">{{ aether_text('all_posts') }} ({{ site.posts.length }}) <span class="arr">→</span></a>
  </div>

  <div class="aether-archive">
    {%- for post in posts %}
      {%- set cat = aether_post_category(post) -%}
      <a class="aether-row{% if loop.first %} is-latest{% endif %}" href="{{ aether_post_url(post) }}">
        <div class="aether-row__body">
          {%- set issue = aether_post_issue(post) -%}
          <div class="aether-row__meta">
            <time class="aether-row__date" datetime="{{ aether_iso_date(post.date) }}">{{ date(post.date, 'YYYY-MM-DD') }}</time>
            <span class="aether-row__cat">{% if issue %}{{ aether_text('issue', issue) }}{% else %}{{ cat }}{% endif %}</span>
            {% if loop.first %}<span class="aether-row__latest">{{ aether_text('newest') }}</span>{% endif %}
          </div>
          <h3 class="aether-row__title">{{ aether_display_title(post) }}</h3>
          {%- set sum = aether_summary(post, 90) -%}
          {%- if sum %}<p class="aether-row__desc">{{ sum }}</p>{% endif %}
          {%- if post.tags and post.tags.length %}
            <div class="aether-row__tags">
              {%- for tag in post.tags.toArray().slice(0, 3) -%}
                <span>{{ tag.name }}</span>
              {%- endfor -%}
            </div>
          {%- endif %}
        </div>
        <span class="aether-row__arr">→</span>
      </a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
