{%- set hero = theme.aether.hero -%}
<section class="aether-intro" aria-label="关于作者">
  <div class="aether-intro__copy">
    {%- if hero.eyebrow %}<p class="aether-intro__eyebrow">{{ hero.eyebrow }}</p>{% endif %}
    <h1>{{ hero.name or config.author or title }}</h1>
    <p class="aether-intro__description">{{ hero.intro or hero.identity or config.description }}</p>
    <div class="aether-intro__links">
      <a href="{{ url_for('/archives/') }}">探索我的思考 <span aria-hidden="true">↗</span></a>
      <a href="{{ url_for('/about/') }}">关于我</a>
    </div>
  </div>
  <div class="aether-organic" aria-hidden="true" data-organic{% if hero.motion === false %} data-static{% endif %}>
    <div class="aether-organic__mesh"></div>
    <img class="aether-organic__still" src="{{ url_for('/images/aether-folio.png') }}" alt="" width="560" height="480" decoding="async">
    <div class="aether-organic__scene"></div>
  </div>
  <div class="aether-intro__foot">
    <span>{{ hero.caption or '写作，让思考慢慢成形。' }}</span>
    {%- if theme.footer.since %}<span>{{ theme.footer.since }} — {{ date(null, 'YYYY') }}</span>{% endif %}
  </div>
</section>
