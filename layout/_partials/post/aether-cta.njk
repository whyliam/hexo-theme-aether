{%- set cfg = theme.aether.cta -%}
{%- if cfg and cfg.enable !== false and theme.scheme === 'Aether' -%}
  {#- skip notes/visuals unless enable_all -#}
  {%- set _type = page.type or page.layout -%}
  {%- if cfg.enable_all or (_type !== 'note' and _type !== 'visual') -%}

  {%- set channels = [] -%}
  {%- if cfg.channels and cfg.channels.length -%}
    {%- set channels = cfg.channels -%}
  {%- elif theme.follow_me -%}
    {#- adapt NexT follow_me dict into label/url -#}
    {%- set _tmp = [] -%}
    {%- for label, val in theme.follow_me -%}
      {%- set _url = val.split('||')[0] | trim -%}
      {%- set _tmp = (_tmp.push({label: label, url: _url}), _tmp) -%}
    {%- endfor -%}
    {%- set channels = _tmp -%}
  {%- endif -%}

<aside class="aether-post-cta" aria-label="关注更新">
  <span class="aether-post-cta__eyebrow">{{ cfg.compact_title or '关注更新' }}</span>
  <div class="aether-post-cta__channels">
    {%- if channels and channels.length %}
      {%- for ch in channels %}
      <a class="aether-post-cta__channel" href="{{ ch.url }}" title="{{ ch.label }}"
         {% if ch.url and ch.url.startsWith('http') %}target="_blank" rel="noopener"{% endif %}>
        <span>{{ ch.short_label or ch.label.split(' · ')[0] }}</span><span class="aether-post-cta__arr" aria-hidden="true">↗</span>
      </a>
      {%- endfor %}
    {%- else %}
      <a class="aether-post-cta__channel" href="{{ url_for('/atom.xml') }}">RSS <span aria-hidden="true">↗</span></a>
    {%- endif %}
  </div>
</aside>

  {%- endif -%}
{%- endif -%}
