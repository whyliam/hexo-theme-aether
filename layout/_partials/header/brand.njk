<div class="site-brand-container">
  <div class="site-nav-toggle">
    <div class="toggle" aria-label="{{ __('accessibility.nav_toggle') }}" role="button"{% if theme.scheme === 'Aether' %} tabindex="0" aria-expanded="false"{% endif %} data-aether-glass="button">
      {%- if theme.menu or (theme.main_menu and theme.main_menu.length) %}
        <span class="toggle-line"></span>
        <span class="toggle-line"></span>
        <span class="toggle-line"></span>
      {%- endif %}
    </div>
  </div>

  <div class="site-meta">
    {%- if theme.custom_logo and theme.scheme === 'Muse' %}
      <img class="custom-logo-image" src="{{ url_for(theme.custom_logo) }}" alt="{{ title }}">
    {%- endif %}

    <a href="{{ config.root }}" class="brand" rel="start">
      <i class="logo-line"></i>
      <{% if is_home() or is_archive() %}h1{% else %}p{% endif %} class="site-title">{{ theme.aether.brand.text or title if theme.scheme === 'Aether' else title }}</{% if is_home() or is_archive() %}h1{% else %}p{% endif %}>
      <i class="logo-line"></i>
    </a>
    {%- if subtitle %}
      <p class="site-subtitle" itemprop="description">{{ subtitle }}</p>
    {%- endif %}
    {%- if theme.custom_logo and (theme.scheme === 'Gemini' or theme.scheme === 'Pisces') %}
      <img class="custom-logo-image" src="{{ url_for(theme.custom_logo) }}" alt="{{ title }}">
    {%- endif %}
  </div>

  <div class="site-nav-right">
    {%- if theme.scheme === 'Aether' and theme.aether.cmdk and theme.aether.cmdk.enable !== false %}
      <button class="toggle aether-mobile-search" type="button" aria-label="{{ aether_text('search') }}" data-aether-cmdk-trigger data-aether-glass="button">
        <i class="fa fa-search" aria-hidden="true"></i>
      </button>
    {%- else %}
    <div class="toggle popup-trigger" aria-label="{{ __('menu.search') }}" role="button"{% if theme.scheme === 'Aether' %} tabindex="0" aria-expanded="false"{% endif %} data-aether-glass="button">
      {%- if theme.algolia_search.enable or theme.local_search.enable %}
        <i class="fa fa-search fa-fw fa-lg"></i>
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</div>
