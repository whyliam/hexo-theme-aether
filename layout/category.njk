{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% import '_macro/aether-archive.njk' as archive_template with context %}

{% block title %}{{ __('title.category') }}: {% if theme.scheme === 'Aether' %}{{ aether_category_label(page.category) }}{% else %}{{ page.category }}{% endif %} | {{ title }}{% endblock %}

{% block class %}category aether-archive{% endblock %}

{% block content %}
  {%- if theme.scheme === 'Aether' %}
  <section class="aether-archive-hero">
    <span class="aether-archive-label">{{ __('title.category') }}</span>
    <h1 class="aether-archive-title">{{ aether_category_label(page.category) }}</h1>
    <p class="aether-archive-desc">{{ site.categories.findOne({name: page.category}).posts.length }} 篇文章</p>
  </section>
  {{ archive_template.navigation('categories') }}

  {%- set current_year = '' %}
  {%- for post in page.posts.toArray() %}
    {%- set year = date(post.date, 'YYYY') %}
    {%- if year !== current_year %}
      {%- if current_year %}</div>{%- endif %}
      {%- set current_year = year %}
      <div class="aether-archive-year-group">
        <h2 class="aether-archive-year">{{ current_year }}</h2>
    {%- endif %}
    {{ archive_template.item(post) }}
  {%- endfor %}
  {%- if current_year %}</div>{%- endif %}

  {%- else %}
  {% import '_macro/post-collapse.njk' as post_template with context %}
  <div class="post-block"><div class="post-content">
    <div class="collection-title">
      <h1 class="collection-header">{{ page.category }} <small>{{ __('title.category') }}</small></h1>
    </div>
    {{ post_template.render(page.posts) }}
  </div></div>
  {%- endif %}

  {%- include '_partials/pagination.njk' -%}
{% endblock %}

{% block sidebar %}
  {% if theme.scheme !== 'Aether' %}{{ sidebar_template.render(false) }}{% endif %}
{% endblock %}
