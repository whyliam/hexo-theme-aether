{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}index{% if theme.scheme === 'Aether' %} aether-home{% else %} posts-expand{% endif %}{% endblock %}

{% block content %}
  {%- if theme.scheme === 'Aether' %}
    {%- for section in aether_home_sections() %}
      {%- if section === 'hero' and theme.aether.hero.enable !== false %}
        {%- include '_partials/home/hero.njk' %}
      {%- elif section === 'latest' and theme.aether.latest.enable !== false %}
        {%- include '_partials/home/latest.njk' %}
      {%- elif section === 'paths' %}
        {%- set paths = theme.aether.start_here or theme.aether.paths %}
        {%- if paths and paths.enable !== false %}{% include '_partials/home/start-here.njk' %}{% endif %}
      {%- elif section === 'series' and theme.aether.series.enable !== false and theme.aether.series_pages.enable !== false %}
        {%- include '_partials/home/series.njk' %}
      {%- elif section === 'personal' and theme.aether.notes_visuals.enable !== false %}
        {%- include '_partials/home/notes-visuals.njk' %}
      {%- elif section === 'subscribe' and theme.aether.newsletter.enable !== false %}
        {%- include '_partials/home/newsletter.njk' %}
      {%- endif %}
    {%- endfor %}
  {%- else %}
    {%- for post in page.posts.toArray() %}
      {{ partial('_macro/post.njk', {post: post, is_index: true}) }}
    {%- endfor %}

    {%- include '_partials/pagination.njk' -%}
  {%- endif %}
{% endblock %}

{% block sidebar %}
  {%- if theme.scheme !== 'Aether' %}
    {{ sidebar_template.render(false) }}
  {%- endif %}
{% endblock %}
