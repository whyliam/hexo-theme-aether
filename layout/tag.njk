{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% import '_macro/aether-archive.njk' as archive_template with context %}

{% block title %}{{ __('title.tag') }}: {{ page.tag }} | {{ title }}{% endblock %}

{% block class %}tag aether-archive{% endblock %}

{% block content %}
  {%- if theme.scheme === 'Aether' %}
  <section class="aether-archive-hero">
    <span class="aether-archive-label">{{ __('title.tag') }}</span>
    <h1 class="aether-archive-title"># {{ page.tag }}</h1>
    <p class="aether-archive-desc">{{ site.tags.findOne({name: page.tag}).posts.length }} 篇文章</p>
  </section>
  {{ archive_template.navigation('tags') }}

  {%- for group in aether_archive_groups(page.posts) %}
    <div class="aether-archive-year-group">
        <h2 class="aether-archive-year">{{ group.year }}</h2>
      {%- for post in group.posts %}
        {{ archive_template.item(post) }}
      {%- endfor %}
    </div>
  {%- endfor %}

  {%- else %}
  {% import '_macro/post-collapse.njk' as post_template with context %}
  <div class="post-block"><div class="post-content">
    <div class="collection-title">
      <h1 class="collection-header">{{ page.tag }} <small>{{ __('title.tag') }}</small></h1>
    </div>
    {{ post_template.render(page.posts) }}
  </div></div>
  {%- endif %}

  {%- include '_partials/pagination.njk' -%}
{% endblock %}

{% block sidebar %}
  {% if theme.scheme !== 'Aether' %}{{ sidebar_template.render(false) }}{% endif %}
{% endblock %}
