{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ __('title.archive') }} | {{ title }}{% endblock %}

{% block class %}archive aether-archive{% endblock %}

{% block content %}
  {%- if theme.scheme === 'Aether' %}
  <section class="aether-archive-hero">
    <span class="aether-archive-label">写作</span>
    <h1 class="aether-archive-title">{{ site.posts.length }} 篇文章</h1>
    {%- set first_post = site.posts.sort('date').toArray()[0] %}
    {%- if first_post %}
    <p class="aether-archive-desc">始于 {{ date(first_post.date, 'YYYY') }}，记录至今。</p>
    {%- else %}
    <p class="aether-archive-desc">记录至今。</p>
    {%- endif %}
  </section>

  {%- set current_year = '' %}
  {%- for post in page.posts.toArray() %}
    {%- set year = date(post.date, 'YYYY') %}
    {%- if year !== current_year %}
      {%- if current_year %}</div>{%- endif %}
      {%- set current_year = year %}
      <div class="aether-archive-year-group">
        <h2 class="aether-archive-year">
          {{ current_year }}
          <span class="aether-archive-year-count">{{ post_count(year) }}</span>
        </h2>
    {%- endif %}

    <article class="aether-archive-item">
      <time class="aether-archive-date" datetime="{{ moment(post.date).format() }}">{{ date(post.date, 'MM-DD') }}</time>
      {%- if post.categories and post.categories.length %}
      <span class="aether-archive-cat">{{ post.categories.toArray()[0].name }}</span>
      {%- endif %}
      <a class="aether-archive-link" href="{{ url_for(post.path) }}">{{ post.title or __('post.untitled') }}</a>
    </article>
  {%- endfor %}
  {%- if current_year %}</div>{%- endif %}

  {%- else %}
  {# NexT fallback #}
  {% import '_macro/post-collapse.njk' as post_template with context %}
  <div class="post-block"><div class="post-content">
    <div class="collection-title">
      <span class="collection-header">{{ _p('counter.archive_posts', site.posts.length) }}</span>
    </div>
    {{ post_template.render(page.posts) }}
  </div></div>
  {%- endif %}

  {%- include '_partials/pagination.njk' -%}
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
