{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}
{% import '_macro/aether-archive.njk' as archive_template with context %}

{% block title %}{{ __('title.archive') }} | {{ title }}{% endblock %}

{% block class %}archive aether-archive{% endblock %}

{% block content %}
  {%- if theme.scheme === 'Aether' %}
  <section class="aether-archive-hero">
    <span class="aether-archive-label">{{ aether_text('writing') }}</span>
    <h1 class="aether-archive-title">{{ aether_text('article_count', site.posts.length) }}</h1>
    <p class="aether-archive-desc">{% if site.posts.length %}{{ aether_text('since', date(site.posts.sort('date').toArray()[0].date, 'YYYY')) }}{% else %}{{ aether_text('empty_archive') }}{% endif %}</p>
  </section>
  {{ archive_template.navigation('archives') }}

  {%- for group in aether_archive_groups(page.posts) %}
    <div class="aether-archive-year-group">
        <h2 class="aether-archive-year">
          {{ group.year }}
          <span class="aether-archive-year-count">{{ post_count(group.year) }}</span>
        </h2>
      {%- for post in group.posts %}
        {{ archive_template.item(post) }}
      {%- endfor %}
    </div>
  {%- endfor %}

  {%- else %}
  {# NexT fallback #}
  {% import '_macro/post-collapse.njk' as post_template with context %}
  <div class="post-block"><div class="post-content">
    <div class="collection-title">
      <span class="collection-header">{{ _p('counter.archive_posts', site.posts.length) }}</span>
    </div>
    {{ post_template.render(page.posts) }}
  </div></div>
  {%- endif %}

  {%- include '_partials/pagination.njk' -%}
{% endblock %}

{% block sidebar %}
  {% if theme.scheme !== 'Aether' %}{{ sidebar_template.render(false) }}{% endif %}
{% endblock %}
