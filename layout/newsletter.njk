{% extends '_layout.njk' %}
{% block title %}Newsletter | {{ title }}{% endblock %}
{% block class %}page aether-newsletter-page{% endblock %}
{% block content %}
{% set series = aether_series_selection(aether_series(), 'Newsletter 周刊').featured %}
<article class="aether-newsletter">
  <header class="aether-newsletter__hero">
    <p class="aether-page-kicker">Newsletter</p>
    <h1>让思考，慢慢抵达。</h1>
    <p class="aether-page-lede">关于 AI、产品与技术世界的观察。用你习惯的方式，接着读下去。</p>
    <div class="aether-subscribe-panel">
      <div><h2>通过 RSS 关注更新</h2><p>邮件订阅尚未开放。现在可以在阅读器里订阅本站。</p></div>
      <div class="aether-actions"><a class="aether-button" href="{{ url_for('/atom.xml') }}">订阅 RSS ↗</a>{% if series %}<a href="{{ url_for(series.url) }}">浏览历史周刊 →</a>{% endif %}</div>
    </div>
  </header>
  {% if series %}
  <section class="aether-newsletter__recent"><h2>最近三期</h2>
    {% for p in series.recent_posts %}<article><time>{{ date(p.date, 'YYYY-MM-DD') }}</time><h3><a href="{{ url_for(p.path) }}">{{ aether_display_title(p) }}</a></h3><p>{{ aether_summary(p, 140) }}</p></article>{% endfor %}
  </section>
  {% endif %}
  <div class="aether-newsletter__body">{{ page.content }}</div>
</article>
{% endblock %}
{% block sidebar %}{% endblock %}
