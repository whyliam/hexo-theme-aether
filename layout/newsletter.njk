{% extends '_layout.njk' %}
{% block title %}{{ page.title or aether_text('subscribe') }} | {{ title }}{% endblock %}
{% block class %}page aether-newsletter-page{% endblock %}
{% block content %}
{% set cfg = theme.aether.newsletter %}
{% set series = aether_series_selection(aether_series(), cfg.series).featured %}
<article class="aether-newsletter">
  <header class="aether-newsletter__hero">
    <p class="aether-page-kicker">{{ page.title or aether_text('subscribe') }}</p>
    <h1>{{ cfg.title or page.title or aether_text('subscribe') }}</h1>
    {% if cfg.description or page.description %}<p class="aether-page-lede">{{ cfg.description or page.description }}</p>{% endif %}
    {% if cfg.rss_url or cfg.email_url %}
    <div class="aether-subscribe-panel" data-aether-glass="surface">
      <div>{% if cfg.rss_label %}<h2>{{ cfg.rss_label }}</h2>{% endif %}{% if cfg.status %}<p>{{ cfg.status }}</p>{% endif %}</div>
      <div class="aether-actions">{% if cfg.rss_url %}<a class="aether-button" href="{{ url_for(cfg.rss_url) }}" data-aether-glass="button">{{ cfg.rss_label or 'RSS' }} ↗</a>{% endif %}{% if cfg.email_url %}<a href="{{ url_for(cfg.email_url) }}">{{ cfg.email_label or 'Email' }}</a>{% endif %}{% if series %}<a href="{{ url_for(series.url) }}">{{ aether_text('all_series') }} →</a>{% endif %}</div>
    </div>
    {% endif %}
  </header>
  {% if series %}
  <section class="aether-newsletter__recent"><h2>{{ cfg.recent_title or aether_text('latest') }}</h2>
    {% for p in series.recent_posts %}<article><time>{{ date(p.date, 'YYYY-MM-DD') }}</time><h3><a href="{{ url_for(p.path) }}">{{ aether_display_title(p) }}</a></h3><p>{{ aether_summary(p, 140) }}</p></article>{% endfor %}
  </section>
  {% endif %}
  <div class="aether-newsletter__body">{{ page.content }}</div>
</article>
{% endblock %}
{% block sidebar %}{% endblock %}
