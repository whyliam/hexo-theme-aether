    "@next-theme/eslint-config": "^0.0.5",
    "c8": "10.1.3",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "hexo": "8.1.1",
    "hexo-renderer-marked": "7.0.1",
    "mocha": "11.7.5",
