{
  "name": "hexo-theme-aether",
  "version": "0.1.0",
  "description": "Aether — a reading-first Hexo theme with configurable liquid glass surfaces.",
  "main": "package.json",
  "files": [
    "docs/AETHER.md",
    "docs/DESIGN.md",
    "docs/CONTENT-STANDARD.md",
    "docs/AUTHORS.md",
    "docs/AGPL3.md",
    "languages",
    "layout",
    "scripts",
    "source",
    "_config.yml",
    "_vendors.yml",
    "docs/MIGRATION-0.1.md",
    "docs/LICENSE.txt"
  ],
  "scripts": {
    "eslint": "eslint scripts/ source/js test/ tools/aether-smoke.js",
    "stylint": "stylelint source/css/ --ip source/css/_common/scaffolding/highlight/index.styl",
    "test": "mocha test/index.js",
    "test-cov": "c8 npm test",
    "hooks:install": "node .githooks/install.js",
    "test:smoke": "node tools/aether-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyliam/hexo-theme-aether.git"
  },
  "keywords": [
    "hexo",
    "hexo-theme",
    "aether",
    "blog",
    "liquid-glass"
  ],
  "dependencies": {
    "css": "^3.0.0",
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.1.1"
  },
  "author": "Liam (https://github.com/whyliam)",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/whyliam/hexo-theme-aether/issues"
  },
  "homepage": "https://github.com/whyliam/hexo-theme-aether",
  "devDependencies": {
    "@next-theme/eslint-config": "^0.0.5",
    "c8": "10.1.3",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "hexo": "8.1.1",
    "hexo-renderer-marked": "7.0.1",
    "mocha": "11.7.5",
    "stylelint": "16.26.1",
    "stylelint-stylus": "1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "contributors": [
    {
      "name": "NexT contributors",
      "url": "https://theme-next.js.org"
    }
  ]
}
